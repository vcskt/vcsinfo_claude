# Database (Neon PostgreSQL with serverless driver)
DATABASE_URL="postgresql://user:password@ep-example-region.neon.tech/dbname?sslmode=require"

# NestJS API
NX_API_PORT=3000
NODE_ENV=development
API_DOMAIN=http://localhost:3000

# Angular Web
NX_WEB_PORT=4200
WEB_DOMAIN=http://localhost:4200

# JWT Secrets
JWT_SECRET=your-jwt-secret-here-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-here-min-32-chars-long
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@vcsinfo.com.br
RESEND_DOMAIN=vcsinfo.com.br

# i18n
DEFAULT_LOCALE=pt

# Cloudflare (future)
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ACCOUNT_ID=your-account-id
